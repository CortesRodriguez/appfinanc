# Clave de Alpha Vantage (opcional, usada como fuente de respaldo del Extractor - RF-02.1)
# Obtener gratis en https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=

# LLM generativo vía Groq (opcional). Cuando USE_LLM=true, las explicaciones se generan
# con el modelo qwen/qwen3.8-27b en lugar de plantillas predefinidas.
# Obtener clave gratis (sin tarjeta) en https://console.groq.com/keys
GROQ_API_KEY=
USE_LLM=false

# Clave secreta de Flask para firmar la sesión (historial de consultas RF-10, sesión anónima RNF-05)
FLASK_SECRET_KEY=cambia-esta-clave-en-produccion

# Base de datos (RF-11, RF-12, RF-13, RF-14). OBLIGATORIA: PostgreSQL es el único
# motor soportado (driver psycopg 3). Se aceptan también postgres:// y postgresql://,
# que se normalizan a postgresql+psycopg://.
DATABASE_URL=postgresql+psycopg://usuario:clave@localhost:5432/appfint

# Solo para pytest: base PostgreSQL DEDICADA a tests. Cada test borra todas las
# tablas, por eso el nombre debe terminar en "_test" (conftest.py lo valida).
TEST_DATABASE_URL=postgresql+psycopg://usuario:clave@localhost:5432/appfint_test

# FinBERT (RF-04.1) es OPCIONAL y solo aporta la etiqueta de sentimiento; el texto
# lo redacta el LLM o las plantillas. Requiere instalar transformers y torch (ver
# requirements.txt). Si se activa sin ellos, el sistema degrada en silencio.
USE_FINBERT=false

# Clave secreta para firmar los tokens JWT de autenticación (RF-17.2). Si se omite, usa FLASK_SECRET_KEY.
JWT_SECRET_KEY=cambia-esta-clave-tambien-en-produccion

# Poner en true solo si la app corre bajo HTTPS (marca la cookie de sesión como Secure).
JWT_COOKIE_SECURE=false

# Login/registro con Google (OAuth2/OIDC vía Authlib). Crear credenciales en
# Google Cloud Console > APIs & Services > Credentials > Create credentials >
# OAuth client ID > tipo "Web application". Como "Authorized redirect URI"
# registrar la URL exacta donde corre el server + "/auth/google/callback",
# por ejemplo http://127.0.0.1:5001/auth/google/callback (ajustar el puerto
# al que realmente use `python app.py`). Si se dejan vacías, el botón de
# Google simplemente no se registra y el resto de la app funciona igual.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
