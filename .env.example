# Clave de Alpha Vantage (opcional, usada como fuente de respaldo del Extractor - RF-02.1)
# Obtener gratis en https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=

# Clave secreta de Flask para firmar la sesión (historial de consultas RF-10, sesión anónima RNF-05)
FLASK_SECRET_KEY=cambia-esta-clave-en-produccion

# Ruta de la base de datos SQLite (RF-13, RF-14, RF-11/RF-12)
DATABASE_URL=sqlite:///appfint.db

# Habilita el uso de FinBERT (transformers) como señal adicional de sentimiento, si está instalado.
USE_FINBERT=false

# Clave secreta para firmar los tokens JWT de autenticación (RF-17.2). Si se omite, usa FLASK_SECRET_KEY.
JWT_SECRET_KEY=cambia-esta-clave-tambien-en-produccion

# Poner en true solo si la app corre bajo HTTPS (marca la cookie de sesión como Secure).
JWT_COOKIE_SECURE=false
